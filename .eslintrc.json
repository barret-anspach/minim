{
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "@stylistic/js", "prettier"],
  "rules": {
    "no-console": 1,
    "prettier/prettier": [
      "error",
      {
        "semi": true
      }
    ],
    "@stylistic/js/semi": ["error", "always"]
  }
}
