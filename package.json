{
  "name": "@quonset/minim",
  "version": "0.0.7",
  "private": false,
  "description": "MNX notation renderer",
  "keywords": [
    "mnx",
    "music",
    "music notation",
    "notation",
    "scoring application",
    "scoring",
    "music renderer"
  ],
  "homepage": "https://github.com/barret-anspach/minim#readme",
  "bugs": {
    "url": "https://github.com/barret-anspach/minim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barret-anspach/minim.git"
  },
  "license": "MIT",
  "author": "Barret Anspach",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "types": "./dist/esm/src/index.d.ts"
    }
  },
  "main": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm",
    "build:esm": "tsc -p tsconfig.json && npm run copy-assets:esm",
    "clean": "rimraf dist/",
    "copy-assets:esm": "copyfiles -u 1 src/**/*.css src/**/**/*.css src/**/*.json src/**/**/*.json dist/esm/src && copyfiles -u 1 public/**/*.woff2 public/*.svg dist/esm/public",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lodash.debounce": "^4.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin-js": "^2.11.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "22.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "copyfiles": "^2.4.1",
    "csstype": "^3.1.3",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "engines": {
    "node": ">=20.x"
  },
  "module": "./dist/esm/src/index.js",
  "engineStrict": true
}
